# Copy this file to .env and fill it in. .env is never committed.
APP_ENV=production
POSTGRES_USER=finance
# Generate with: openssl rand -hex 24
# (hex avoids characters like @ and / that break the database URL)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=finance
# Comma-separated. Empty in production. For local development:
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=
# The web app's address (the Vercel URL). Browser requests that change data must come from it.
# Leave empty until the frontend is deployed: the API then refuses all of them, which is safe.
APP_ORIGINS=
# Cookies travel only over https. Set to false ONLY to test over plain http, then set it back.
COOKIE_SECURE=true